TELEGRAM_BOT_TOKEN=
TIMEZONE=Europe/Paris
DATABASE_PATH=data/productif_ops.sqlite

# Comma-separated Telegram user IDs that receive global recaps.
# Leave EMPTY rather than writing a placeholder: 0 is not a valid chat id and is
# now dropped. When empty, recaps go to whoever is linked as noah.
ADMIN_TELEGRAM_IDS=

# Required second argument of /start, e.g. `/start gaetan rentree2026`.
# Leave empty only for a local test: without it, anyone who finds the bot can
# claim an unclaimed identity and read the whole team plan.
OPS_ENROLL_CODE=

# For local demo data. Keep true until real tasks are imported.
SEED_SAMPLE_DATA=true

# Bind the private API locally and expose it through an HTTPS reverse proxy on the VPS.
OPS_API_HOST=127.0.0.1
OPS_API_PORT=8787
