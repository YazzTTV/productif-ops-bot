TELEGRAM_BOT_TOKEN=
TIMEZONE=Europe/Paris
DATABASE_PATH=data/productif_ops.sqlite

# Comma-separated Telegram user IDs that receive global recaps.
# Fill this after sending /start noah once, or get your ID with @userinfobot.
ADMIN_TELEGRAM_IDS=

# For local demo data. Keep true until real tasks are imported.
SEED_SAMPLE_DATA=true

# Bind the private API locally and expose it through an HTTPS reverse proxy on the VPS.
OPS_API_HOST=127.0.0.1
OPS_API_PORT=8787
