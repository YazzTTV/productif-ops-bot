<service>
  <id>ProductifOpsBot</id>
  <name>Productif Ops Telegram Bot</name>
  <executable>C:\productif-ops-bot\.venv\Scripts\productif-ops-bot.exe</executable>
  <workingdirectory>C:\productif-ops-bot</workingdirectory>
  <logpath>C:\productif-ops-bot\logs</logpath>
  <log mode="roll"/>
  <onfailure action="restart" delay="5 sec"/>
  <!-- See the API service file: unbuffered output is what makes the log usable. -->
  <env name="PYTHONUNBUFFERED" value="1"/>
</service>
